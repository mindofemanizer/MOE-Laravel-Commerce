{
    "name":  "moe/laravel-commerce",
    "description":  "Commerce module â€” Store, Product, Cart, Order (Single \u0026 Multi Store)",
    "type":  "library",
    "license":  "MIT",
    "keywords":  [
                     "laravel",
                     "commerce",
                     "store",
                     "product",
                     "cart",
                     "order",
                     "e-commerce",
                     "moe"
                 ],
    "authors":  [
                    {
                        "name":  "MindOfEmanizer",
                        "email":  "mindofemanizer@users.noreply.github.com"
                    }
                ],
    "support":  {
                    "issues":  "https://github.com/mindofemanizer/MOE-Laravel-Commerce/issues",
                    "source":  "https://github.com/mindofemanizer/MOE-Laravel-Commerce"
                },
    "require":  {
                    "php":  "^8.2",
                    "illuminate/support":  "^11.0|^12.0|^13.0",
                    "moe/laravel-core":  "^1.0.0",
                    "moe/laravel-inventory":  "^1.0.0",
                    "moe/laravel-shipping":  "^1.0.0"
                },
    "require-dev":  {
                        "orchestra/testbench":  "^9.0",
                        "pestphp/pest":  "^3.0"
                    },
    "autoload":  {
                     "psr-4":  {
                                   "Moe\\Commerce\\":  "src/"
                               }
                 },
    "autoload-dev":  {
                         "psr-4":  {
                                       "Moe\\Commerce\\Tests\\":  "tests/"
                                   }
                     },
    "repositories":  [
                         {
                             "type":  "vcs",
                             "url":  "https://github.com/mindofemanizer/MOE-Laravel-Core"
                         },
                         {
                             "type":  "vcs",
                             "url":  "https://github.com/mindofemanizer/MOE-Laravel-Inventory"
                         },
                         {
                             "type":  "vcs",
                             "url":  "https://github.com/mindofemanizer/MOE-Laravel-Shipping"
                         }
                     ],
    "extra":  {
                  "laravel":  {
                                  "providers":  [
                                                    "Moe\\Commerce\\CommerceServiceProvider"
                                                ]
                              }
              },
    "scripts":  {
                    "test":  "pest",
                    "test-coverage":  "pest --coverage"
                },
    "config":  {
                   "sort-packages":  true,
                   "allow-plugins":  {
                                         "pestphp/pest-plugin":  true
                                     }
               },
    "minimum-stability":  "dev",
    "prefer-stable":  true
}