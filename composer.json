{
    "name": "moe/laravel-commerce",
    "description": "Commerce module — Store, Product, Cart, Order (Single & Multi Store)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "commerce",
        "store",
        "product",
        "cart",
        "order",
        "e-commerce",
        "moe"
    ],
    "authors": [
        {
            "name": "MindOfEmanizer",
            "email": "mindofemanizer@users.noreply.github.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mindofemanizer/MOE-Laravel-Commerce/issues",
        "source": "https://github.com/mindofemanizer/MOE-Laravel-Commerce"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "moe/laravel-core": "dev-main",
        "moe/laravel-inventory": "dev-main",
        "moe/laravel-shipping": "dev-main"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Moe\\Commerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moe\\Commerce\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/mindofemanizer/MOE-Laravel-Core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/mindofemanizer/MOE-Laravel-Inventory"
        },
        {
            "type": "vcs",
            "url": "https://github.com/mindofemanizer/MOE-Laravel-Shipping"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Moe\\Commerce\\CommerceServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
